{
  "manifest_version": 3,
  "name": "YT-DL CONNECT",
  "version": "1.0.6",
  "description": "Send the current tab's video to the YT-DL desktop downloader: pick quality or audio format, then watch real progress.",

  "action": {
    "default_popup": "popup.html",
    "default_title": "YT-DL CONNECT",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "service_worker.js"
  },

  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "key": ""
}
